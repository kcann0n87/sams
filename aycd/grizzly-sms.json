{
  "name": "Grizzly SMS",
  "description": "api.grizzlysms.com \u2014 handler_api.php protocol, plain-text responses",
  "version": "1.0.0",
  "author": "sams-automation",
  "priceFormat": "USD",
  "credentials": [
    {
      "name": "apiKey",
      "label": "API Key",
      "description": "grizzlysms.com > profile > API key",
      "required": true
    }
  ],
  "generalApi": {
    "getBalance": {
      "method": "GET",
      "url": "https://api.grizzlysms.com/stubs/handler_api.php?api_key=${credentials.apiKey}&action=getBalance",
      "responseType": "TEXT",
      "responseMapping": {
        "balance": "^ACCESS_BALANCE:"
      }
    }
  },
  "tempApi": {
    "userDataFields": [
      {
        "name": "service",
        "label": "Service Code",
        "description": "Grizzly SMS's own short code. Walmart is wr, Sam's Club is sams. For anything else, open https://api.grizzlysms.com/stubs/handler_api.php?api_key=YOUR_KEY&action=getServicesList in a browser and search it. Codes are per-site \u2014 one from another provider will buy the wrong service.",
        "required": true,
        "defaultValue": "wr"
      },
      {
        "name": "country",
        "label": "Country ID",
        "description": "Numeric country id. 187 is the United States across this family.",
        "required": true,
        "defaultValue": "187"
      }
    ],
    "userDataConfigs": [
      {
        "name": "US Walmart",
        "values": {
          "country": "187",
          "service": "wr"
        }
      },
      {
        "name": "US Sam's Club",
        "values": {
          "country": "187",
          "service": "sams"
        }
      }
    ],
    "getPhoneNumber": {
      "method": "GET",
      "url": "https://api.grizzlysms.com/stubs/handler_api.php?api_key=${credentials.apiKey}&action=getNumber&service=${userData.service}&country=${userData.country}",
      "responseType": "TEXT",
      "responseMapping": {
        "phoneNumber": "^ACCESS_NUMBER:\\d+:",
        "orderId": "^ACCESS_NUMBER:|:\\d+$"
      }
    },
    "getMessage": {
      "method": "GET",
      "url": "https://api.grizzlysms.com/stubs/handler_api.php?api_key=${credentials.apiKey}&action=getStatus&id=${session.orderId}",
      "responseType": "TEXT",
      "responseMapping": {
        "message": "^STATUS_OK:"
      },
      "pendingCheck": {
        "type": "BODY_CONTAINS",
        "value": "STATUS_WAIT"
      },
      "pollingIntervalSeconds": 5
    },
    "cancelPhoneNumber": {
      "method": "GET",
      "url": "https://api.grizzlysms.com/stubs/handler_api.php?api_key=${credentials.apiKey}&action=setStatus&id=${session.orderId}&status=8",
      "responseType": "TEXT"
    }
  }
}
