{
  "name": "CyberYozh",
  "description": "app.cyberyozh.com — residential and virtual numbers, X-Api-Key header",
  "version": "0.9.1",
  "author": "sams-automation",
  "priceFormat": "USD",
  "credentials": [
    {
      "name": "apiKey",
      "label": "API Key",
      "description": "app.cyberyozh.com > profile menu > API Keys",
      "required": true
    }
  ],
  "tempApi": {
    "userDataFields": [
      {
        "name": "provider",
        "label": "Provider type",
        "description": "residential is non-VoIP and the better bet for retail sites. virtual is cheaper. Rentals are the _rent variants — not what you want for one code.",
        "required": true,
        "defaultValue": "residential"
      },
      {
        "name": "service",
        "label": "Service code",
        "description": "Code from GET /numbers/services/. Residential codes look like se024415f170e25; virtual ones are short, like wr.",
        "required": true,
        "defaultValue": "se024415f170e25"
      },
      {
        "name": "country",
        "label": "Country code",
        "description": "Numeric code from GET /numbers/countries/. United States America is 667.",
        "required": true,
        "defaultValue": "667"
      },
      {
        "name": "period",
        "label": "Period",
        "description": "MIN_15 is the only value for virtual and residential. Rentals take HOUR_4, DAY, WEEK and so on.",
        "required": true,
        "defaultValue": "MIN_15"
      }
    ],
    "userDataConfigs": [
      {
        "name": "Walmart — residential",
        "values": {
          "provider": "residential",
          "service": "se024415f170e25",
          "country": "667",
          "period": "MIN_15"
        }
      },
      {
        "name": "Walmart Family Mobile — residential",
        "values": {
          "provider": "residential",
          "service": "s9629aca71a8b02",
          "country": "667",
          "period": "MIN_15"
        }
      },
      {
        "name": "Walmart MoneyCard — residential",
        "values": {
          "provider": "residential",
          "service": "s5e85c951385be4",
          "country": "667",
          "period": "MIN_15"
        }
      },
      {
        "name": "Walmart — virtual (cheaper, VoIP risk)",
        "values": {
          "provider": "virtual",
          "service": "wr",
          "country": "667",
          "period": "MIN_15"
        }
      }
    ],
    "getPhoneNumber": {
      "method": "POST",
      "url": "https://app.cyberyozh.com/api/v1/numbers/",
      "headers": {
        "X-Api-Key": "${credentials.apiKey}",
        "accept": "application/json"
      },
      "body": {
        "provider": "${userData.provider}",
        "service_code": "${userData.service}",
        "country_code": "${userData.country}",
        "period": "${userData.period}",
        "need_fraud_score": false,
        "markup_percent": 0
      },
      "contentType": "application/json",
      "responseType": "JSON",
      "responseMapping": {
        "phoneNumber": "$.phone_number",
        "orderId": "$.pk"
      },
      "errorCheck": {
        "path": "$.detail",
        "messageField": "$.detail"
      },
      "rateLimit": {
        "maxConcurrency": 1,
        "delayMillis": 1000
      }
    },
    "getMessage": {
      "method": "GET",
      "url": "https://app.cyberyozh.com/api/v1/numbers/",
      "headers": {
        "X-Api-Key": "${credentials.apiKey}",
        "accept": "application/json"
      },
      "responseType": "JSON",
      "responseMapping": {
        "message": "$[0].history_sms_code"
      },
      "pendingCheck": {
        "type": "FIELD_ABSENT",
        "path": "$[0].history_sms_code"
      },
      "pollingIntervalSeconds": 5
    }
  }
}
